FROM genevol:latest

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY script/simulation/parametric_bootstrap.py script/simulation/parametric_bootstrap.py

ENTRYPOINT ["python3", "-u", "script/simulation/parametric_bootstrap.py", \
            "--param-file", "/app/genevol/param_file.txt", \
            "--output-dir", "/app/genevol/bootstrap_output", \
            "--keep-tmp"]
